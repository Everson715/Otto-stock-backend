# ==== BANCO DE DADOS ====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clinica

# No docker-compose a string é montada automaticamente a partir das variáveis acima.
# Use esta URL apenas se for rodar o backend fora do Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinica?schema=public

# ==== SEGURANÇA ====
# Altere para uma chave longa e segura em produção
JWT_SECRET=super_secret_jwt_key_example

# Segredo HMAC-SHA256 usado para hashear e-mail e IP nas chaves de rate limit (mínimo 10 caracteres)
# Se omitido, usa fallback interno baseado em JWT_SECRET.
# RATE_LIMIT_KEY_SECRET=super_secret_rate_limit_hmac_key

# ==== CONFIGURAÇÕES DA API & PROXY ====
# Porta interna do container (deixe 3000)
PORT=3000
# CORS_ORIGINS=*

# Número de proxies reversos confiáveis na frente da API para leitura de X-Forwarded-For.
# Padrão: 1 (apenas o Nginx do docker-compose).
# Se houver outro balanceador/proxy na frente do Nginx (ex.: Cloudflare, AWS ALB, Traefik), aumente este valor (ex.: 2).
# TRUST_PROXY=1

# ==== RATE LIMITING ====
# Limite máximo de requisições por janela de 15 min para usuários autenticados (entre 10 e 100000).
# Padrão: 600 em produção (ou quando NODE_ENV ausente) e 3000 apenas quando NODE_ENV=development.
# RATE_LIMIT_MAX=600

# Limite máximo de requisições por janela de 15 min por IP para visitantes sem token (entre 10 e 100000).
# Padrão: 120 em produção (600 quando NODE_ENV=development).
# RATE_LIMIT_ANON_MAX=120
