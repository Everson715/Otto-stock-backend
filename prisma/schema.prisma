generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  perfis    Perfil[] @default([ATENDENTE])
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  movimentacoes MovimentacaoEstoque[]
}

enum Perfil {
  ADMIN
  ESTOQUISTA
  ATENDENTE
  GESTOR
}

model Paciente {
  id               Int      @id @default(autoincrement())
  nome             String
  cpf              String   @unique
  dataNascimento   DateTime?
  contato          String?
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())

  atendimentos     Atendimento[]
}

model Medico {
  id     Int     @id @default(autoincrement())
  nome   String
  crm    String? @unique
  ativo  Boolean @default(true)

  atendimentos Atendimento[]
}

model Exame {
  id           Int      @id @default(autoincrement())
  nome         String   @unique
  descricao    String?
  codigo       String?  @unique
  departamento String?
  ativo        Boolean  @default(true)

  createdAt    DateTime @default(now())

  insumos      ExameInsumo[]
  atendimentos Atendimento[]
}

model Insumo {
  id               Int      @id @default(autoincrement())
  nome             String   @unique
  sku              String?  @unique
  unidade          String   @default("un")
  categoria        String?
  fabricante       String?
  quantidadeMinima Int      @default(0)
  ativo            Boolean  @default(true)

  createdAt        DateTime @default(now())

  exames         ExameInsumo[]
  movimentacoes  MovimentacaoEstoque[]
}

model MovimentacaoEstoque {
  id            Int      @id @default(autoincrement())
  tipo          TipoMovimentacao
  motivo        String?  
  quantidade    Int

  insumoId      Int
  insumo        Insumo   @relation(fields: [insumoId], references: [id])

  usuarioId     Int?
  usuario       Usuario? @relation(fields: [usuarioId], references: [id])

  atendimentoId Int?
  atendimento   Atendimento? @relation(fields: [atendimentoId], references: [id])

  createdAt     DateTime @default(now())

  @@index([insumoId])
  @@index([createdAt])
  @@index([atendimentoId])
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
}

model ExameInsumo {
  id         Int @id @default(autoincrement())

  exameId    Int
  insumoId   Int
  quantidade Int

  exame      Exame  @relation(fields: [exameId], references: [id])
  insumo     Insumo @relation(fields: [insumoId], references: [id])

  @@unique([exameId, insumoId])
}

model Atendimento {
  id                 Int @id @default(autoincrement())

  pacienteId         Int
  medicoId           Int
  exameId            Int

  status             StatusAtendimento @default(EM_ATENDIMENTO)
  observacoes        String?
  finalizadoEm       DateTime?
  canceladoEm        DateTime?
  motivoCancelamento String?

  criadoEm           DateTime @default(now())

  paciente           Paciente @relation(fields: [pacienteId], references: [id])
  medico             Medico   @relation(fields: [medicoId], references: [id])
  exame              Exame    @relation(fields: [exameId], references: [id])
  movimentacoes      MovimentacaoEstoque[]

  @@index([status])
  @@index([criadoEm])
}

enum StatusAtendimento {
  EM_ATENDIMENTO
  FINALIZADO
  CANCELADO
}